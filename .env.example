# --- Database / cache (docker compose defaults) ---
DATABASE_URL=postgresql+psycopg://hookd:hookd@localhost:5432/hookd
REDIS_URL=redis://localhost:6379/0

# --- SQS (ElasticMQ locally; leave AWS_ENDPOINT_URL empty in AWS) ---
AWS_REGION=ap-southeast-2
AWS_ENDPOINT_URL=http://localhost:9324
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SYNC_QUEUE_URL=http://localhost:9324/000000000000/hookd-sync

# --- Cognito ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- Sync ---
# inline: "Sync now" runs in the API process (needed while stores are in-memory)
# queue:  the API queues jobs on SYNC_QUEUE_URL for the worker
SYNC_MODE=inline
SYNC_LOOKBACK_DAYS=30
# Campaign dates and weekly/monthly targets are calendar days in this timezone
CAMPAIGN_TIMEZONE=Australia/Brisbane

# --- TikTok (TIKTOK_MODE=mock uses fake data for the demo; live uses the Research API) ---
TIKTOK_MODE=mock
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- MCP server ---
HOOKD_API_URL=http://localhost:8000/api
